{
  "name": "@aa/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "seed": "node src/scripts/seed.js",
    "seed:demo-exam": "node src/scripts/seed-demo-exam.js",
    "seed:demo-full": "node src/scripts/seed-demo-full.js",
    "migrate:encrypt": "node src/scripts/encrypt-existing-data.js",
    "retention:dry-run": "node src/scripts/retention-dry-run.js",
    "scrub:logs": "node src/scripts/scrub-logs.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
