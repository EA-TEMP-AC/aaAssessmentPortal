# Copy to .env and fill in local values. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Replica set URI (see docker-compose.yml). Transactions require replica set.
MONGO_URI=mongodb://127.0.0.1:27017/aa_portal?replicaSet=rs0&directConnection=true

# JWT — replace with long random strings in local .env only
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
