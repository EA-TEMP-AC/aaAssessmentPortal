# Copy to .env and fill in local values. Never commit real secrets.
NODE_ENV=development
PORT=3000

# Replica set URI (see docker-compose.yml). Transactions require replica set.
MONGO_URI=mongodb://127.0.0.1:27017/aa_portal?replicaSet=rs0&directConnection=true

# Access-token signing secret. Required when NODE_ENV=production (at least 32 characters).
# The server does not apply a fallback secret.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# bcrypt cost for password hashes. Integer from 4 to 15. Defaults to 10 when unset.
# BCRYPT_COST=10

# Dev seed only (`npm run seed`). Not used by the API.
# When unset, the seed script uses the documented default Dev-Password-1.
# SEED_PASSWORD=Dev-Password-1

# SMTP for the email queue worker. Leave SMTP_HOST empty to queue mail without sending.
# SMTP_PASSWORD is a credential. The server must not log it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aa.example

# Field-level encryption of personal data (S-01). Required when NODE_ENV=production.
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# FIELD_ENCRYPTION_KEYS=k1:<base64 32-byte key>
# FIELD_ENCRYPTION_KEY_ID=k1
# FIELD_HASH_KEY=<base64 key, at least 32 bytes>
# Outside production, unset keys fall back to a built-in development key (do not use real data).
